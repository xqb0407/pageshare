# docker compose 用：cp .env.example .env 后填写。
# .env 已被 .gitignore 排除——不要把真实密钥提交进仓库！
# 生成密钥：openssl rand -hex 16（auth_token）/ openssl rand -hex 32（cookie_secret）

# —— 必填 ——
PS_AUTH_TOKEN=
PS_COOKIE_SECRET=
# 分享链接前缀（浏览器实际看到的地址），例如 https://share.example.com
PS_PUBLIC_BASE_URL=http://localhost:8300

# —— 可选 ——
# 宿主机发布端口（容器内固定 8300）
PS_LISTEN_PORT=8300
# 泛分享域名（配了才有 {id}.s.share.example.com 直连站点；需 DNS 泛解析 + tls profile）
PS_SITE_WILDCARD_HOST=
# 覆盖发布保留最近几版（回滚窗口；1=即删旧版，0=全保留慎用）
PS_VERSIONS_KEPT=3

# —— 存储：默认 disk（数据进 compose 卷）；生产建议 Cloudflare R2 / 任意 S3 兼容桶 ——
PS_STORAGE_BACKEND=disk
# PS_STORAGE_BACKEND=s3
# PS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# PS_S3_REGION=auto
# PS_S3_BUCKET=pageshare
# PS_S3_ACCESS_KEY_ID=
# PS_S3_SECRET_ACCESS_KEY=
# PS_S3_PREFIX=
